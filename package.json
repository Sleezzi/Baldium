{
	"name": "baldium",
	"author": "Sleezzi",
	"license": "ISC",
	"private": true,
	"workspaces": [
		"packages/*",
		"services/api",
		"services/socket-proxy",
		"services/backup"
	],
	"scripts": {
		"build:types": "npm run build --workspace=@baldium/shared-types",
		"build:api": "npm run build --workspace=@baldium/api",
		"build:socket-proxy": "npm run build --workspace=@baldium/socket-proxy",
		"build:backup": "npm run build --workspace=@baldium/backup"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"devDependencies": {
		"@types/node": "^26.2.0"
	}
}
